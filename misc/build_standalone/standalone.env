# Simplified GenRA .env settings for pre-built image standalone
# deployment.  Typically no changes will be needed.

# Port on host for API
EXT_GENRA_API_PORT=8447

# Port on host for UI
EXT_GENRA_UI_PORT=8448

# host reported by Swagger, can be set to non-local domain to generate API spec.
GENRA_SWAGGER_HOST=localhost:${EXT_GENRA_API_PORT}

# subpath for API endpoints
GENRA_API_PREFIX=/genra-api

# to enable invocation of flask app instance, e.g. flask commands
# This isn't needed by deployments
FLASK_APP=genraweb.genra_flask:app

# Celery broker url, redis or RabbitMQ etc.
GENRA_CELERY_BROKER=redis://redis:6379/0
# Set this to any non-blank value to run celery in the genra_api container.
GENRA_CELERY_IN_GENRA=Y

# Green Unicorn control
# NOTE: setting --threads > 1 causes green unicorn to use gthread rather
# than sync workers which may in turn allow it to detect busy vs. dead
# threads, so we should always set --threads > 1.
GUNICORN_CMD_ARGS="--bind=0.0.0.0:5000 --workers=6 --threads 4"

# set to 'Y' (case-sensitive) to use new (2021) db structures
GENRA_NEW_TOXREF_DB=Y

# Link from neighbors for background info.  Processed with str.format().
# Currently only 'chem_id' available for substitution.
GENRA_DETAILS_LINK="https://comptox.epa.gov/dashboard/chemical/details/{chem_id}"

# pick one of: {LOCAL, LOCAL_DEV, DEV, STG, PROD}
GENRA_DEPLOYMENT_TYPE=PROD

GENRA_UI_REPO_PATH=../genra-ui
GENRA_ENV_NAME=docker_dist
GENRA_BASE=python:3.11

# mongo default settings for local db
GENRA_DB_DB=genra
GENRA_DB_HOST=genra_mongo

# vim: set ft=config:
